SYNTHETIC_API_KEY=
# syn:large:text (GLM-5.3-Flash) hung requests indefinitely on 2026-09-18;
# K3 completed a 9-turn review of a real PR cleanly.
SYNTHETIC_MODEL=hf:moonshotai/Kimi-K3
BITBUCKET_EMAIL=you@example.com
# git-over-HTTPS authenticates with username, not email
BITBUCKET_USERNAME=
BITBUCKET_API_KEY=
BITBUCKET_WORKSPACE=
# HONE_DATA_DIR=~/.local/share/hone
# Per-repo static-check tooling lives in repos.toml, not here.
# HONE_REPO_CONFIG=repos.toml
# HONE_MAX_TURNS=15
# HONE_PORT=8420
# Required for `hone serve` — set in Bitbucket when creating the webhook
# HONE_WEBHOOK_SECRET=

# GitHub support is optional and all-or-nothing: leave both of these
# blank to disable it; set both (never just one — that's a startup
# ConfigError) to review GitHub PRs too.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# Required for `hone serve` to mount /webhook/github — set in GitHub when
# creating the webhook. Missing while GITHUB_TOKEN is set just skips that
# route (logged warning); it does not stop the server from starting.
# GITHUB_WEBHOOK_SECRET=
