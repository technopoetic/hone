LLM_API_KEY=
# Model id expected by the configured Anthropic-compatible endpoint.
LLM_MODEL=
# Unset = Anthropic directly; set for an Anthropic-Messages-API-compatible proxy.
# LLM_BASE_URL=https://api.synthetic.new/anthropic

# Configure at least one complete forge group. Leave other groups unset.
# BITBUCKET_EMAIL=you@example.com
# BITBUCKET_USERNAME=
# BITBUCKET_API_KEY=
# BITBUCKET_WORKSPACE=
# Required to serve Bitbucket webhooks; not required for `hone review`.
# BITBUCKET_WEBHOOK_SECRET=

# GITHUB_TOKEN=
# GITHUB_OWNER=
# Required to serve GitHub webhooks; not required for `hone review`.
# GITHUB_WEBHOOK_SECRET=

# GITLAB_TOKEN=
# Explicit base URL, including any self-managed relative URL path.
# GITLAB_URL=https://gitlab.com
# Full user/group path pinned by the webhook route.
# GITLAB_NAMESPACE=engineering
# GitLab 19.1+ Standard Webhooks signing token (with the whsec_ prefix); review-only does not need it.
# GITLAB_WEBHOOK_SIGNING_TOKEN=

# HONE_DATA_DIR=~/.local/share/hone
# HONE_REPO_CONFIG=repos.toml
# HONE_MAX_TURNS=15
# HONE_PORT=8420
